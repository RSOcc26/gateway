# Configuration for the gateway.
# Copy to .env for local development. Never commit .env.
# Every value below is a placeholder.

# HTTP
PORT=8080
LOG_LEVEL=info

# Internal service URLs (local ports from the deploy repository's Compose setup)
IDENTITY_URL=http://localhost:3001
ACCESS_URL=http://localhost:3002
WORKFLOW_URL=http://localhost:3003
INVENTORY_URL=http://localhost:3004
PRODUCTION_URL=http://localhost:3005

# Limits and timeouts
UPSTREAM_TIMEOUT_MS=5000
RATE_LIMIT_PER_MINUTE=300
MAX_BODY_BYTES=1048576
MEMBERSHIP_CACHE_TTL_SECONDS=30

# Tenant context forwarded to services (ADR-0001)
TENANT_CONTEXT_ISSUER=companycentral-gateway
# Private key file; generate a local key under .local/ (git-ignored).
TENANT_CONTEXT_SIGNING_KEY_FILE=.local/tenant-context-key.pem
TENANT_CONTEXT_TTL_SECONDS=60

# Authentication settings depend on ADR-0002 (custom identity or OIDC) and are
# added when that decision is made.
